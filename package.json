{
  "name": "audiobookshelf",
  "version": "2.37.0",
  "buildNumber": 1,
  "description": "Self-hosted audiobook and podcast server",
  "main": "dist-server/index.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "nodemon --watch server --watch index.js --watch test --watch dev.js --ext js,ts --exec \"npm run build:server && node dist-server/index.js\" -- --dev",
    "start": "node dist-server/index.js",
    "start-dev": "node dist-server/index.js --prod-with-dev-env",
    "client": "cd client && npm ci && npm run generate",
    "prod": "npm run client && npm ci && npm run build:server && npm run start",
    "build-win": "npm run client && npm run build:server && pkg --config package.json -t node24-win-x64 -o ./dist/win/audiobookshelf -C GZip dist-server/index.js",
    "build-win-no-compress": "npm run client && npm run build:server && pkg --config package.json -t node24-win-x64 -o ./dist/win/audiobookshelf dist-server/index.js",
    "build-linux": "build/linuxpackager",
    "docker": "docker buildx build --platform linux/amd64,linux/arm64 --push .  -t advplyr/audiobookshelf",
    "docker-amd64-local": "docker buildx build --platform linux/amd64 --load .  -t advplyr/audiobookshelf-amd64-local",
    "docker-arm64-local": "docker buildx build --platform linux/arm64 --load .  -t advplyr/audiobookshelf-arm64-local",
    "deploy-linux": "node deploy/linux",
    "test": "npm run build:server && mocha dist-server/test",
    "coverage": "npm run build:server && nyc mocha dist-server/test",
    "lint": "eslint ."
  },
  "bin": "dist-server/index.js",
  "pkg": {
    "assets": [
      "client/dist/**/*",
      "node_modules/sqlite3/lib/binding/**/*.node",
      "dist-server/server/migrations/*.js"
    ],
    "scripts": [
      "dist-server/index.js",
      "dist-server/server/**/*.js"
    ]
  },
  "mocha": {
    "recursive": true
  },
  "author": "advplyr",
  "license": "GPL-3.0",
  "dependencies": {
    "axios": "^0.27.2",
    "cookie-parser": "^1.4.6",
    "express": "^4.17.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.17.3",
    "graceful-fs": "^4.2.10",
    "htmlparser2": "^8.0.1",
    "lru-cache": "^10.0.3",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^6.9.13",
    "openid-client": "^5.6.1",
    "p-throttle": "^4.1.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "semver": "^7.6.3",
    "sequelize": "^6.35.2",
    "socket.io": "^4.5.4",
    "sqlite3": "^5.1.7",
    "ssrf-req-filter": "^1.1.0",
    "xml2js": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "chai": "^4.3.10",
    "eslint": "^10.11.0",
    "mocha": "^10.2.0",
    "nodemon": "^2.0.20",
    "nyc": "^15.1.0",
    "sinon": "^17.0.1",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
